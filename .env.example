# Copie para .env e preencha pra rodar localmente. Em produção (Coolify), cadastre como
# Environment Variables do recurso — nunca commite o .env de verdade.

DATABASE_URL=postgresql://usuario:senha@host:5432/banco
EVOLUTION_API_URL=https://evolution.seudominio.com.br
EVOLUTION_API_KEY=chave-global-da-evolution-api

# opcionais
REMINDER_INTERVAL_MINUTES=30
CONTEXT_WINDOW_MESSAGES=20
OPENAI_MODEL=gpt-4o-mini
TZ=America/Sao_Paulo
